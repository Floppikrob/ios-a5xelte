+#if defined(DREAMLTE)
+/*
+ * Copy of the console in TWRP's ramoops pmsg zone, in persistent_ram
+ * format (sig "DBGC", start, size, ring data), appended to the loader's
+ * text there. After a forced reboot TWRP shows loader + kernel log as
+ * /sys/fs/pstore/pmsg-ramoops-0. (The dump zone survives too but this
+ * TWRP does not expose it; the console zone header sits on RAM cells that
+ * lose the same bits on every forced reboot.)
+ */
+#define KLOG_CAP        (A5_KLOG_SIZE - 12)
+static volatile uint32_t *klog_hdr;
+static volatile uint8_t *klog_data;
+static uint32_t klog_start, klog_size;
+static void klog_putc(uint8_t c);
+
+static void
+klog_init(void)
+{
+	klog_hdr = (volatile uint32_t *)ml_io_map(A5_KLOG_PHYS, A5_KLOG_SIZE);
+	if (klog_hdr == NULL) {
+		return;
+	}
+	klog_data = (volatile uint8_t *)(klog_hdr + 3);
+	/* Continue after the loader's text if its header is sane. */
+	if (klog_hdr[0] == 0x43474244u && klog_hdr[1] == klog_hdr[2] &&
+	    klog_hdr[2] < KLOG_CAP - 0x10000) {
+		klog_start = klog_size = klog_hdr[2];
+	} else {
+		klog_hdr[0] = 0x43474244u;
+		klog_start = klog_size = 0;
+	}
+	const char *banner = "\n--- XNU console ---\n";
+	for (; *banner; banner++) {
+		klog_putc((uint8_t)*banner);
+	}
+}
+
+static void
+klog_putc(uint8_t c)
+{
+	if (klog_data == NULL) {
+		return;
+	}
+	klog_data[klog_start] = c;
+	klog_start = (klog_start + 1) % KLOG_CAP;
+	if (klog_size < KLOG_CAP) {
+		klog_size++;
+	}
+	klog_hdr[1] = klog_start;
+	klog_hdr[2] = klog_size;
+}
